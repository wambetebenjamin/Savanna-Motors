# ---------------------------------------------------------------- site
NEXT_PUBLIC_SITE_URL=https://savannamotors.co.ke

# ---------------------------------------------------------------- Vercel KV
# Injected automatically when a KV store is attached to the Vercel project.
# Without them every endpoint still works, backed by an in-process store.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------------------------------------------------------------- WhatsApp
# Optional. Without a Cloud API token the site falls back to wa.me deep links
# (which is what every public-facing WhatsApp button uses anyway).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEALER_NUMBER=254112272061

# ---------------------------------------------------------------- Email
# SendGrid HTTP API (no SMTP egress needed on Vercel).
SENDGRID_API_KEY=
MAIL_FROM=sales@savannamotors.co.ke

# ---------------------------------------------------------------- Currency
# ExchangeRate-API key. Omitted → the free open.er-api.com endpoint is used,
# and a pinned fallback rate keeps the USD price from ever rendering empty.
EXCHANGE_RATE_API_KEY=

# ---------------------------------------------------------------- M-Pesa Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://savannamotors.co.ke/api/mpesa/callback

# ---------------------------------------------------------------- NTSA / registration
NTSA_API_URL=
NTSA_API_KEY=

# ---------------------------------------------------------------- Optional 360 viewer
NEXT_PUBLIC_SPIN360_URL=
